<?xml version="1.0" encoding="utf-8"?>
<!-- Backup / device-transfer rules for Android 12 (API 31) and above. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="database/"/>
        <include domain="sharedpref" path="."/>

        <!-- FMTC map tile cache lives at files/fmtc/ and is regenerable; excluding
             keeps backups under Android's 25 MB Auto Backup limit. -->
        <exclude domain="file" path="fmtc/"/>
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="database/"/>
        <include domain="sharedpref" path="."/>

        <!-- Tile cache is regenerable; skip transferring it to keep the transfer fast. -->
        <exclude domain="file" path="fmtc/"/>
    </device-transfer>
</data-extraction-rules>
