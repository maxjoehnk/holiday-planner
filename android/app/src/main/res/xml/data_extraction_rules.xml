<?xml version="1.0" encoding="utf-8"?>
<!-- Backup / device-transfer rules for Android 12 (API 31) and above. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="db.sqlite"/>
        <include domain="sharedpref" path="."/>
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="db.sqlite"/>
        <include domain="sharedpref" path="."/>
    </device-transfer>
</data-extraction-rules>
